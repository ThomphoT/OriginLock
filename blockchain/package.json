{
  "name": "originlock-blockchain",
  "version": "1.0.0",
  "description": "OriginLock — Anchor/Solana smart contract for decentralized IP ownership",
  "license": "MIT",
  "scripts": {
    "test": "anchor test",
    "test:local": "anchor test --skip-local-validator",
    "compile": "anchor build",
    "deploy:local": "anchor deploy --provider.cluster localnet",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "export-idl": "node scripts/export-idl.js",
    "verify": "ts-node scripts/verify.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.8"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "chai": "^4.5.0",
    "mocha": "^10.7.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
