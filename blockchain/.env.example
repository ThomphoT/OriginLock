# Solana RPC endpoints
SOLANA_RPC_URL_LOCAL=http://localhost:8899
SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com

# Deployer wallet private key (JSON array from keypair file)
DEPLOYER_PRIVATE_KEY=/path/to/your/solana-keypair.json

# Program ID (set after first deploy)
PROGRAM_ID=ORILOCk111111111111111111111111111111111111

# Anchor wallet path
ANCHOR_WALLET=~/.config/solana/id.json
