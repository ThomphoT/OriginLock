{
  "name": "originlock",
  "version": "0.1.0",
  "metadata": {
    "description": "OriginLock — Anchor program for decentralized IP ownership on Solana",
    "address": "ORILOCk111111111111111111111111111111111111"
  },
  "instructions": [
    {
      "name": "registerIdea",
      "accounts": [
        { "name": "idea", "isMut": true, "isSigner": false },
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "contentHash", "type": "string" },
        { "name": "title", "type": "string" }
      ]
    },
    {
      "name": "verifyOwnership",
      "accounts": [
        { "name": "idea", "isMut": false, "isSigner": false }
      ],
      "args": []
    }
  ],
  "accounts": [
    {
      "name": "IdeaRecord",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "owner", "type": "publicKey" },
          { "name": "contentHash", "type": "string" },
          { "name": "title", "type": "string" },
          { "name": "timestamp", "type": "i64" },
          { "name": "exists", "type": "bool" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "IdeaRegistered",
      "fields": [
        { "name": "hash", "type": "string", "index": true },
        { "name": "owner", "type": "publicKey", "index": true },
        { "name": "timestamp", "type": "i64", "index": false }
      ]
    }
  ],
  "errors": [
    { "code": 6000, "name": "HashAlreadyRegistered", "msg": "Hash already registered" },
    { "code": 6001, "name": "HashNotFound", "msg": "Hash not found" }
  ]
}
